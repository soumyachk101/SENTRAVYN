{
  "name": "@sentravyn/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "SENTRAVYN mobile application (Expo + React Native)",
  "main": "index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\" \"**/*.tsx\" --max-warnings 0",
    "test": "node --experimental-strip-types --test \"src/__tests__/*.test.ts\""
  },
  "dependencies": {
    "@sentravyn/api-client": "workspace:*",
    "@sentravyn/shared-types": "workspace:*",
    "expo": "~58.0.23",
    "expo-location": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@eslint/js": "9.0.0",
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
