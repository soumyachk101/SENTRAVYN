{
  "name": "@sentravyn/backend",
  "version": "0.0.0",
  "private": true,
  "description": "SENTRAVYN NestJS API and background workers",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "prisma generate && jest --config jest-e2e.config.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/swagger": "11.4.8",
    "@sentravyn/shared-types": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.0",
    "@types/supertest": "6.0.0",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "@eslint/js": "9.0.0",
    "eslint-config-prettier": "10.0.0"
  }
}
