{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": false,
    "noEmit": false,
    "outDir": "./dist",
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts", "worker/**/*.ts", "test/**/*.ts"]
}
