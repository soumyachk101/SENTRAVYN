# syntax=docker/dockerfile:1

# SENTRAVYN NestJS API container image (ARCHITECTURE.md 9: Docker + Terraform).
#
# A pnpm + Turborepo monorepo — the backend resolves @sentravyn/shared-types
# as a workspace dependency and its Prisma client is generated into
# node_modules — so the image is built in two stages:
#
#   build  : install the whole workspace (matches the CI gate), build the
#            shared-types dist + the NestJS API + the notification worker,
#            then produce a pruned, self-contained runtime dir with
#            `pnpm deploy` (the reliable way to ship a pnpm workspace pkg).
#   runtime: node:22-slim, non-root, the prebuilt dist + pruned node_modules
#            only. No build toolchain, no source, no lockfile.
#
# The image is the API service (runs `node dist/main.js`). The BullMQ
# notification worker is a SEPARATE deployable — build it with
# `backend/Dockerfile.worker` (ARCHITECTURE.md 9: separate worker containers
# that scale independently of the API).
#
# NOTE: `prisma migrate deploy` is run at deploy time by the pipeline
# (Terraform / the CI image step) against DATABASE_URL; the container itself
# only runs the already-generated Prisma client, so it does not need the
# schema at runtime.

ARG NODE_VERSION=22
ARG PNPM_VERSION=11.9.0

# ---------------------------------------------------------------------------
# 1. Build: install + compile the backend and its workspace dependency.
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-slim AS build
ARG PNPM_VERSION
# Prisma's `prisma generate` picks the query-engine binary to download based
# on the system OpenSSL. node:slim lacks libssl3, so without this it defaults
# to the openssl-1.1.x variant that then fails to link at runtime. Install the
# same shared libs the runtime stage gets so the generated engine matches what
# the container will actually load.
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends libssl3 libstdc++6 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /repo

# Lockfile + workspace manifest first for layer caching.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
# Root tsconfig the workspace packages extend (packages/*/tsconfig.json and
# backend/tsconfig.json all "extends" tsconfig.base.json).
COPY tsconfig.base.json ./
# The two workspace packages the backend build depends on (its own manifest +
# @sentravyn/shared-types).
COPY packages/shared-types/package.json packages/shared-types/
COPY backend/package.json backend/

# Install the full workspace (as the CI gate does), pinned to the lockfile.
RUN pnpm install --frozen-lockfile

# The source for everything the API build touches.
COPY packages/shared-types/ packages/shared-types/
COPY backend/ backend/

# Build shared-types (dist/index.js + .d.ts), then the API (prisma generate +
# nest build -> backend/dist/main.js) and the worker (-> backend/dist-worker).
RUN pnpm --filter @sentravyn/shared-types build \
 && pnpm --filter @sentravyn/backend build \
 && pnpm --filter @sentravyn/backend worker:build

# Prune into a self-contained runtime tree for the backend package only.
# `--legacy`: since pnpm v10, deploy from a workspace requires either
# inject-workspace-packages=true or the --legacy flag; we want a plain pruned
# node_modules with the workspace dependency resolved to its built dist.
RUN pnpm --filter @sentravyn/backend deploy /repo/runtime --legacy

# Regenerate the Prisma client INSIDE the deployed runtime tree.
#
# Why: `pnpm deploy` re-lays-out node_modules for /repo/runtime. The Prisma
# client generated by the earlier `pnpm build` lives against the *build*
# tree's pnpm store and is not re-registered for the runtime store, so the
# `@prisma/client` package in the runtime tree stays as its "please run
# prisma generate" stub and the app throws "@prisma/client did not initialize
# yet" on boot. This is the Prisma-documented step for pnpm + Docker: the
# client is a native, architecture-specific artifact, so it must be (re)generated
# against the exact node_modules layout the runtime will load. Both stages use
# the same base arch and now carry libssl3, so the generated engine matches.
# `prisma generate` needs no DB connection — only the schema (which
# `pnpm deploy` carries) and the client package in node_modules. The client is
# written into the pnpm store (node_modules/.pnpm/@prisma+client@.../.prisma),
# not top-level; verify it via the actual boot path: constructing a
# PrismaClient must not throw the "did not initialize yet" stub error.
RUN cd /repo/runtime \
 && ./node_modules/.bin/prisma generate \
 && node -e "new (require('@prisma/client').PrismaClient)(); console.log('prisma client OK')"

# ---------------------------------------------------------------------------
# 2. Runtime: slim, non-root, prebuilt artifacts only.
# ---------------------------------------------------------------------------
FROM node:${NODE_VERSION}-slim AS runtime
# Prisma's generated client loads a native query-engine binary that links
# against libssl/libstdc++; node:slim ships without them, so at boot the
# client throws "@prisma/client did not initialize yet." Install the runtime
# shared libs Prisma needs (its documented fix). ca-certificates keeps HTTPS
# to Postgres/Redis and any provider calls working.
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends libssl3 libstdc++6 ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# A non-root principal so the container follows least-privilege (SECURITY.md).
RUN groupadd -g 1001 sentravyn && useradd -u 1001 -g sentravyn -m sentravyn
WORKDIR /app

# The pruned node_modules + package.json for the backend package.
COPY --from=build /repo/runtime/node_modules ./node_modules
COPY --from=build /repo/runtime/package.json ./package.json
# The compiled API entrypoint (and the worker build, harmless alongside it).
COPY --from=build /repo/backend/dist ./dist
COPY --from=build /repo/backend/dist-worker ./dist-worker

USER sentravyn
EXPOSE 4000
# The API listens on API_PORT (default 4000; main.ts). Overridden per-environment.
ENV NODE_ENV=production API_PORT=4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||4000)+'/api/v1/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1

CMD ["node", "dist/main.js"]
