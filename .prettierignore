# Lockfiles
pnpm-lock.yaml
package-lock.json
yarn.lock
# Terraform provider lock file is committed (pins the provider version) but is
# a hash-pinned generated artifact — never reformatted by Prettier.
*.lock.hcl

# Build output / generated / caches
dist/
dist-worker/
out/
.next/
.turbo/
.expo/
coverage/
node_modules/

# Terraform: the .terraform/ dir holds the downloaded provider binary (an ELF
# plugin Prettier cannot read); the lock file is committed but unparseable.
.terraform/
*.tfstate

# Next.js generated type reference
next-env.d.ts

# Prisma: generated client + applied SQL migrations are DB state; never reformat
backend/prisma/migrations/

# Generated api-client bundle (gitignored test artifact); never reformat
packages/api-client/test/client.bundle.mjs

# tsconfig files are JSONC and may carry comments; Prettier would strip them
**/tsconfig*.json

# Binary / font assets
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.woff
*.woff2
*.ttf
*.otf
*.mp4
*.mp3

# Hand-written docs and SQL keep their own formatting (out of Prettier scope)
*.md
*.sql

# Env files (gitignored); Prettier must not touch any that exist locally
.env
.env.*

# Local agent worktrees (gitignored; never present in a CI checkout)
.claude/

# YAML (CI workflow + workspace build-allowlists) stay hand-managed;
# Prettier reflowing them is not worth the diff noise
*.yml
*.yaml
docs/evidence/
