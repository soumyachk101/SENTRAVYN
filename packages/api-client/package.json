{
  "name": "@sentravyn/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed REST client for the SENTRAVYN API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest && node test/build.mjs && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@sentravyn/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "esbuild": "0.25.0",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
