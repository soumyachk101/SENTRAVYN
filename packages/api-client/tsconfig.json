{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    // This client targets browser + PWA runtimes (and the Expo/Next clients),
    // so it relies on the standard fetch/URLSearchParams globals.
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"]
}
