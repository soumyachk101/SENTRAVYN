{
  "name": "@sentravyn/shared-types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript contracts for SENTRAVYN surfaces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
