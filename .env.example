# SENTRAVYN local development template
# Never place real credentials in this file.

NODE_ENV=development
APP_ENV=local

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3001

# PostgreSQL + PostGIS
DATABASE_URL=postgresql://sentravyn:sentravyn_local_password@localhost:5432/sentravyn?schema=public

# Local Docker host port overrides (read by infrastructure/docker/docker-compose.yml).
# Defaults keep the standard ports; on a host where 5432/6379 are already taken
# by another project, remap here and update DATABASE_URL / REDIS_URL to match.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication — configure with selected OIDC provider
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REDIRECT_URL=

# Maps — use a provider whose terms permit your usage
MAP_STYLE_URL=
GEOCODING_PROVIDER=
GEOCODING_API_KEY=

# Push notifications — configure only when implemented
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=

# Object storage
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Monitoring
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Provider configuration
GDACS_ENABLED=false
USGS_ENABLED=false
COPERNICUS_ENABLED=false

# SEO / webmaster — set only after purchasing and configuring real domain
SITE_URL=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
